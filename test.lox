class CoffeeMaker {
  init(coffee) {
    this.coffee = coffee;
  }

  brew() {
    if (!this.coffee) {
      print "Nothing to brew.";
      return;
    }

    print "Enjoy your cup of " + this.coffee + "!";

    // No reusing the grounds!
    this.coffee = nil;
  }
}

class EspressoMachine < CoffeeMaker {
  init() {
    super.init("espresso");
  }

  brew() {
    print "Brewing espresso...";
    super.brew();
  }
}

var machine = EspressoMachine();
machine.brew();
machine.brew();
