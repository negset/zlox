class Fruit {
  init(color) {
    this.color = color;
  }

  showColor() {
    print "color: " + this.color;
  }
}

class Apple < Fruit {
  init(color, name) {
    super.init(color);
    this.name = name;
  }

  showName() {
    print "name: " + this.name;
  }
}

var apple = Apple("#FF0000", "Asahi");
print apple;
apple.showName();
apple.showColor();
